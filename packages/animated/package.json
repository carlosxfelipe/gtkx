{
    "name": "@gtkx/animated",
    "version": "1.0.0-rc.1",
    "description": "Framer Motion-powered animation for GTKX: the animated factory, AnimatePresence, gestures, drag, and layout animations rendered as GTK CSS",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "framer-motion",
        "motion",
        "animation",
        "react",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/animated"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": [
        "./src/motion-env.ts",
        "./dist/motion-env.js",
        "./src/features/register.ts",
        "./dist/features/register.js"
    ],
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.lib.json",
        "typecheck": "tsc -b --emitDeclarationOnly",
        "release": "tsx ../../scripts/release-package.ts"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@gtkx/css": "workspace:*",
        "@gtkx/react": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "framer-motion": "^12.42.2",
        "motion-dom": "^12.42.2"
    },
    "devDependencies": {
        "@gtkx/config": "workspace:*",
        "@gtkx/testing": "workspace:*",
        "@gtkx/vitest": "workspace:*",
        "react": "catalog:"
    },
    "peerDependencies": {
        "react": "^19"
    }
}
