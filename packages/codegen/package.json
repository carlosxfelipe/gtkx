{
    "name": "@gtkx/codegen",
    "version": "1.0.0-rc.1",
    "description": "GIR-driven generator for the GTKX FFI bindings, React elements, and API reference documentation",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "gir",
        "codegen",
        "typescript",
        "ffi"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/codegen"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "overrides",
        "src"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.lib.json",
        "typecheck": "tsc -b --emitDeclarationOnly",
        "release": "tsx ../../scripts/release-package.ts"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@gtkx/config": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "fast-xml-parser": "^5.10.0",
        "typescript": "catalog:"
    }
}
