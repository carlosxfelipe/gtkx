{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": ["node"],
        "outDir": "out-tsc",
        "rootDir": "."
    },
    "include": ["src/**/*", "tests/**/*"]
}
