{
    "name": "animated-gallery",
    "version": "0.0.0",
    "private": true,
    "license": "MPL-2.0",
    "description": "Progressive gallery of @gtkx/animated: springs, gestures, presence, layout projection, and drag",
    "type": "module",
    "scripts": {
        "build": "gtkx build",
        "coverage": "vitest run --coverage",
        "typecheck": "gtkx codegen && tsc -b --emitDeclarationOnly",
        "dev": "gtkx dev",
        "start": "node dist/bundle.js"
    },
    "dependencies": {
        "@gtkx/animated": "workspace:*",
        "@gtkx/components": "workspace:*",
        "@gtkx/css": "workspace:*",
        "@gtkx/react": "workspace:*",
        "react": "catalog:"
    },
    "devDependencies": {
        "@gtkx/cli": "workspace:*",
        "@gtkx/config": "workspace:*",
        "@gtkx/native": "workspace:*",
        "@gtkx/testing": "workspace:*",
        "@vitest/coverage-v8": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
